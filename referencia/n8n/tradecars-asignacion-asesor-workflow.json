    {
      "parameters": {
        "jsCode": "// Trade Cars — Asignación de asesor. Extrae el teléfono directo del payload del webhook\n// (conversation_created) — TODAVÍA no existe la fila en tradecars_leads_chatwoot para esta\n// conversación (esa la crea el OTRO flujo, \"Lead desde mensaje de Chatwoot\", al leer el\n// mensaje con IA — puede tardar unos segundos). Por eso el teléfono se saca acá mismo, sin\n// esperar a ese otro flujo:\n//   - WhatsApp: meta.sender.phone_number ya viene confirmado por Chatwoot.\n//   - Instagram/Facebook: ese campo viene null — se busca con una expresión regular en el\n//     texto del primer mensaje (\"Phone number: 972619000\"), el mismo patrón que ya usa el\n//     otro flujo como respaldo.\n\nconst item = $input.first().json;\nconst raw = item.body ?? item;\n\nconst conversationId = raw.id ?? raw.conversation?.id ?? null;\nconst accountId = raw.account_id ?? raw.messages?.[0]?.account_id ?? null;\nconst sender = raw.meta?.sender ?? {};\nconst contacto = sender.name ?? null;\n\nfunction normalizarTelefono(valor) {\n  let digitos = String(valor ?? '').replace(/[^\\d]/g, '');\n  if (digitos.length === 11 && digitos.startsWith('51')) digitos = digitos.slice(2);\n  return digitos;\n}\n\nlet telefono = normalizarTelefono(sender.phone_number);\nif (!telefono) {\n  const texto = String(raw.messages?.[0]?.content ?? '');\n  const m = texto.match(/phone\\s*number[:\\s]*([\\d\\s+()-]{6,})/i);\n  if (m) telefono = normalizarTelefono(m[1]);\n}\n\nreturn [{\n  json: {\n    conversation_id: conversationId,\n    account_id: accountId,\n    contacto,\n    telefono,\n  },\n}];\n"
      },
      "id": "a1b2c3d4-1111-4a2b-9c3d-4e5f6a7b8c9d",
      "name": "Extraer teléfono",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [432, -160]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://dashboard.alef.company/api/tradecars/chatwoot-asesor-previo?telefono={{ $json.telefono }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "tradecars-chatwoot-lead-2026"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "neverError": true,
              "responseFormat": "json"
            }
          }
        }
      },
      "id": "a1b2c3d4-2222-4a2b-9c3d-4e5f6a7b8c9d",
      "name": "Buscar asesor previo",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [656, -160]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
