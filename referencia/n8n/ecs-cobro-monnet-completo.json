        "jsonBody": "={\n  \"content\": \"✅ *¡Pago confirmado!*\\n\\nGracias {{ $('When Executed by Another Workflow').first().json.cliente_nombre }}, recibimos tu pago de *S/ {{ $('When Executed by Another Workflow').first().json.monto }}* por *{{ $('When Executed by Another Workflow').first().json.plan_nombre }}*.\\n\\nTu suscripción ya está activa 🍀\\nPronto te llegará tu boleta electrónica al correo *{{ $('When Executed by Another Workflow').first().json.cliente_email }}*.\",\n  \"message_type\": \"outgoing\",\n  \"content_type\": \"text\"\n}",
        "options": {}
