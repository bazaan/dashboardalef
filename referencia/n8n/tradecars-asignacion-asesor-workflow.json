      "id": "a1b2c3d4-3333-4a2b-9c3d-4e5f6a7b8c9d",
      "name": "¿Tiene asesor previo?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [880, -160]
    },
    {
      "parameters": {
        "jsCode": "// El telefono ya tuvo una conversacion anterior con asesor asignado — se deriva la\n// conversacion NUEVA al mismo asesor, sin pasar por el round robin.\nconst datos = $('Extraer teléfono').first().json;\nconst previo = $input.first().json;\n\nreturn [{\n  json: {\n    conversation_id: datos.conversation_id,\n    account_id: datos.account_id,\n    assignee_id: previo.id_asesor_asignado,\n    asesor_nombre: previo.asesor_asignado,\n    contacto: datos.contacto,\n  },\n}];\n"
      },
      "id": "a1b2c3d4-4444-4a2b-9c3d-4e5f6a7b8c9d",
      "name": "Usar asesor previo",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1104, -320]
    },
    {
      "parameters": {
        "jsCode": "// ---- CONFIGURA TUS 4 ASESORES (ids reales de Chatwoot) ----\nconst ASESORES = [\n  { id: 55, nombre: 'Asesor 1' },\n  { id: 56, nombre: 'Asesor 2' },\n  { id: 57, nombre: 'Asesor 3' },\n  { id: 58, nombre: 'Asesor 4' },\n];\n\n// Estado persistente del workflow (solo persiste en ejecuciones de produccion)\nconst state = $getWorkflowStaticData('global');\nif (typeof state.rrIndex !== 'number') state.rrIndex = -1;\nif (!Array.isArray(state.procesadas)) state.procesadas = [];\n\n// El telefono/conversation_id/account_id ya se extrajeron en \"Extraer teléfono\" (antes de\n// consultar si hay un asesor previo) — se leen de ahi, no del input directo de este nodo\n// (que ahora es la respuesta de \"Buscar asesor previo\", sin esos datos).\nconst datos = $('Extraer teléfono').first().json;\nconst conversationId = datos.conversation_id;\nconst accountId = datos.account_id;\n\nif (!conversationId || !accountId) return [];\n\n// Anti-duplicado: si Chatwoot reenvia el webhook, no volvemos a asignar\nif (state.procesadas.includes(conversationId)) return [];\nstate.procesadas.push(conversationId);\nif (state.procesadas.length > 300) state.procesadas.shift();\n\n// Round robin 1 a 1\nstate.rrIndex = (state.rrIndex + 1) % ASESORES.length;\nconst asesor = ASESORES[state.rrIndex];\n\nreturn [{\n  json: {\n    conversation_id: conversationId,\n    account_id: accountId,\n    assignee_id: asesor.id,\n    asesor_nombre: asesor.nombre,\n    turno: state.rrIndex + 1,\n    contacto: datos.contacto,\n  },\n}];"
      },
      "id": "1bddc5fe-32a1-4acb-baf8-b004a1cdf5e3",
      "name": "Round Robin Asesores",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1104, 0]
    },
