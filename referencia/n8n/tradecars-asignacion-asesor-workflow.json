    {
      "parameters": {},
      "id": "2652dfc0-a7b2-4d15-ad19-c687b3bdf4e6",
      "name": "No Aplica",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [432, 112]
