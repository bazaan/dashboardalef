        "jsonBody": "={\n  \"content\": \"⏳ *Procesando tu pago...*\\n\\nYa recibimos tu autorización en Yape. En unos segundos te confirmamos por aquí.\",\n  \"message_type\": \"outgoing\",\n  \"content_type\": \"text\"\n}",
        "options": {}
